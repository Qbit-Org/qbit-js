{
  "name": "qbit-js",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK packages for qbit protocol, API, and wallet integration",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:test": "pnpm -r --if-present typecheck:test",
    "fixtures:check": "bash scripts/check-core-fixtures.sh",
    "clean": "pnpm -r --if-present clean",
    "pack:check": "node scripts/check-pack.mjs",
    "consumer:check": "node scripts/check-packed-consumer.mjs",
    "smoke:consumer": "pnpm --filter @qbit-oss/protocol --filter @qbit-oss/api build && node scripts/run-consumer-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "docs:api:check": "typedoc --emit none && node scripts/check-doc-links.mjs",
    "verify": "pnpm format:check && pnpm build && pnpm test && pnpm typecheck && pnpm typecheck:test && pnpm pack:check && pnpm consumer:check"
  },
  "keywords": [
    "qbit",
    "protocol",
    "wallet",
    "typescript",
    "sdk"
  ],
  "author": "Qbit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qbit-Org/qbit-js.git"
  },
  "bugs": {
    "url": "https://github.com/Qbit-Org/qbit-js/issues"
  },
  "homepage": "https://github.com/Qbit-Org/qbit-js#readme",
  "devDependencies": {
    "prettier": "3.9.10",
    "typedoc": "0.28.20"
  }
}
